# Copiá este archivo a .env (opcional). Sin STRIPE_SECRET_KEY el checkout usa el simulador local.
PORT=3000
BASE_URL=http://localhost:3000
# Llave secreta de PRUEBA de Stripe (empieza con sk_test_). Dejala vacía para usar el simulador.
STRIPE_SECRET_KEY=
# Panel admin (por defecto admin / 123)
ADMIN_USER=admin
ADMIN_PASS=123
